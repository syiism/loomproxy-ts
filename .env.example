# 配置键的唯一真源是 packages/kernel/src/config.ts 的 DEFAULTS（键名与默认值以那里为准）。
# 这份示例只列**实现里真的有人读**的键：写了却没人读的键 = 面板/运维以为配上了，
# 实际什么也没发生（AUTH_ENABLED 的历史就是这个形状）。
# 相对路径一律相对**进程 cwd**（换目录启动 = 换库；启动日志会打印解析后的库路径与管理员名）。
# 注意：值后面**不要**写行内注释——解析器只按等号切分，注释会被当成值的一部分。
# 这份文件可以直接复制成 .env 用（改成 .env 后重启进程生效）。

# ── 服务 ──
# 监听地址
SERVER_HOST=0.0.0.0
# 监听端口（面板在 /，探针 GET /health）
SERVER_PORT=8081
# info | debug（非法值按 info）
SERVER_LOG_LEVEL=info
# 平台时区：日界、额度窗口、榜单窗口都按它算
TZ_OFFSET_HOURS=8
# 控制面信封里的 code（与 HTTP 状态码无关）
ERROR_CODE=-1

# ── 数据与插件 ──
# 数据目录（默认库文件在这里）
DATA_DIR=data
# 库文件路径（相对 cwd）。留空 = DATA_DIR/loomproxy.db
# DB_PATH=data/loomproxy.db
# 兼容 Go 版的键名；本实现固定 SQLite，值不参与分支
DB_TYPE=sqlite
# 插件目录：<PLUGIN_DIR>/<code>/<version>/manifest.json
PLUGIN_DIR=plugins
# 面板静态产物目录
WEB_DIST=web/dist
# 源包 data_files 的匹配后缀
DATA_FILE_GLOB=*.json

# ── 取数栈（源的唯一出口：缓存 → 合并 → 熔断 → 代理/直连 → 上游） ──
# 连接超时（秒）
TIMEOUT_CONNECT=5
# 单次上游请求超时（秒）
TIMEOUT_POOL=10
# 进程内 LRU 默认 TTL（秒）
CACHE_TTL=300
CACHE_MAXSIZE=128
# 上游响应短 TTL 缓存（秒）与条目上限
UPSTREAM_CACHE_TTL=10
UPSTREAM_CACHE_MAXSIZE=512
# 过期后仍可回陈旧值的倍数
UPSTREAM_CACHE_STALE_MULT=3
# 熔断：同一 host 连续失败即快速失败，避免堆在挂起的上游上
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURES=5
# 熔断冷却（秒）
CIRCUIT_BREAKER_COOLDOWN=30

# ── IP 代理池（两个来源可叠加，按请求合并；按 URL 复用连接） ──
# 逗号分隔，如 http://1.2.3.4:8080,socks5://user:密码@5.6.7.8:1080
UPSTREAM_PROXIES=
# 代理文件：每行一个，空行与 # 注释跳过；按 mtime 热加载（5 秒检查一次）
UPSTREAM_PROXY_FILE=
# 走不走代理按源/接口门控：设置项 proxy_enabled_sources（面板「系统设置 · 站点」），
# 支持 novel_a（整源）与 novel_a/chapter（单接口）两种粒度；留空 = 不限制（配了池就全走）。
# 未实现（别写进 .env，写了也不会生效）：动态代理 API、代理三连败封禁、代理失败换一个再回退直连。

# ── 请求头 ──
# true = 源没显式指定 User-Agent 时按请求轮换（池子 12 条，移动端为主，与 Go 版逐条一致）
UPSTREAM_UA_ROTATE=false

# ── 鉴权 ──
# false = 可选鉴权（带凭证就认出身份，没带按匿名走免费套餐档）；true = 数据面必须有凭证
AUTH_ENABLED=false
# 静态 API Key（逗号分隔）：算"有凭证但匿名"，控制面拒收
API_KEYS=
# 免强制路径（前缀匹配：等于它或以它 + / 开头）
AUTH_WHITELIST=/,/data,/auth/register,/auth/login,/panel
# 生产必须改成强随机值；保持默认值 + AUTH_ENABLED=true 会拒绝启动
JWT_SECRET=
# token 有效期（小时）；-1 = 永不过期；设置项 jwt_expire_hours 覆盖它
JWT_EXPIRE_HOURS=168

# ── 管理员（只用于**创建**；改密后以库为准，见 ADMIN_PASSWORD_SYNC） ──
ADMIN_USERNAME=admin
# 留空 = 首启随机生成并打印一次；之后把口令写进这里重启即生效
ADMIN_PASSWORD=
# true = 强制用这里的口令覆盖库中口令（面板上改过也覆盖）
ADMIN_PASSWORD_SYNC=false

# ── 计费与监控 ──
# 同内容去重窗口（秒）：挡住"客户端超时重试"重复扣费
BILLING_DEDUPE_SEC=300
# 明细保留天数；0 = 永久（聚合表 api_call_stats 始终保留）
MONITOR_RETENTION_DAYS=0
# 公开榜聚合缓存（秒）；<=0 每次真算
RANK_CACHE_SEC=60

# ── 号池 ──
# false = 不启动任何源声明的号池（排障时用）
POOL_ENABLED=true

# ── systemd socket activation（部署项；本地开发不要设） ──
# LISTEN_FDS / LISTEN_PID 由 systemd 注入：拿到 fd 就接过来，拿不到就按 SERVER_HOST/SERVER_PORT 自绑。
# LISTEN_FDS=1