{
  "name": "loomproxy-ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check": "pnpm run check:layers && pnpm run check:types && pnpm run check:web && pnpm run check:web-contract && pnpm run test",
    "check:layers": "node tools/check-layers.mjs",
    "check:types": "tsc -p tsconfig.json",
    "test": "node --test \"packages/*/test/*.test.ts\" \"packages/plugins/*/test/*.test.ts\" \"packages/pool/test/*.test.ts\" \"apps/*/test/*.test.ts\"",
    "dev": "node --watch apps/server/src/main.ts",
    "probe:fq": "node tools/plugin-run.mjs fq_novel search query=三体",
    "check:web": "pnpm -F @loomproxy/web build",
    "dev:web": "pnpm -F @loomproxy/web dev",
    "check:web-contract": "node tools/check-web-contract.mjs",
    "analyze:mysql": "node tools/analyze-mysql-traffic.mjs",
    "migrate:mysql": "node tools/mysql-to-sqlite.mjs",
    "parity:write": "node tools/write-parity.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "fastify": "^5.0.0",
    "mysql2": "^3.24.6",
    "undici": "^7.0.0",
    "zod": "^3.23.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
